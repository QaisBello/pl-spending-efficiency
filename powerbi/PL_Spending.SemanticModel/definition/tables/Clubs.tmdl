/// One row per club: totals, titles and points above expected with 95% bootstrap confidence intervals (reported and verdict-adjusted).
table Clubs

	column club
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: club

	column seasons
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: seasons

	column pts
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: pts

	column titles
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: titles

	column avg_pts
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: avg_pts

	column avg_wage_index
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: avg_wage_index

	column avg_over_pts
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: avg_over_pts

	column over_pts_ci_low
		dataType: double
		formatString: +0.0;-0.0;0.0
		summarizeBy: none
		sourceColumn: over_pts_ci_low

	column over_pts_ci_high
		dataType: double
		formatString: +0.0;-0.0;0.0
		summarizeBy: none
		sourceColumn: over_pts_ci_high

	column total_over_pts
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: total_over_pts

	column avg_over_pts_adj
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: avg_over_pts_adj

	column over_pts_ci_low_adj
		dataType: double
		formatString: +0.0;-0.0;0.0
		summarizeBy: none
		sourceColumn: over_pts_ci_low_adj

	column over_pts_ci_high_adj
		dataType: double
		formatString: +0.0;-0.0;0.0
		summarizeBy: none
		sourceColumn: over_pts_ci_high_adj

	column cost_per_point_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: cost_per_point_gbp_m

	column net_spend_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: net_spend_gbp_m

	partition Clubs = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "club_summary.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"club", type text},
				            {"seasons", Int64.Type},
				            {"pts", Int64.Type},
				            {"titles", Int64.Type},
				            {"avg_pts", type number},
				            {"avg_wage_index", type number},
				            {"avg_over_pts", type number},
				            {"over_pts_ci_low", type number},
				            {"over_pts_ci_high", type number},
				            {"total_over_pts", type number},
				            {"avg_over_pts_adj", type number},
				            {"over_pts_ci_low_adj", type number},
				            {"over_pts_ci_high_adj", type number},
				            {"cost_per_point_gbp_m", type number},
				            {"net_spend_gbp_m", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

