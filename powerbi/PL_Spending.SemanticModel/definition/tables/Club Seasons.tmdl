/// Every club and season, 2008-09 to 2025-26, with wages and revenue where the accounts were found (8 of 108 wage bills are missing and are not estimated). Used for the money measures, which do not need the regression.
table 'Club Seasons'

	/// Wages as reported in the accounts.
	measure 'Wage Bill' = SUM ( 'Club Seasons'[wages_gbp_m] )
		formatString: £#,0.0"m"
		displayFolder: Money

	/// Revenue as reported.
	measure Revenue = SUM ( 'Club Seasons'[revenue_gbp_m] )
		formatString: £#,0.0"m"
		displayFolder: Money

	/// Sponsorship the verdict found was funded by the owner (City only).
	measure 'Owner-Funded Sponsorship' = SUM ( 'Club Seasons'[owner_funded_sponsorship_gbp_m] )
		formatString: £#,0.0"m"
		displayFolder: Money

	/// Wage bill as a share of reported revenue.
	measure 'Wages to Revenue' = DIVIDE ( [Wage Bill], [Revenue] )
		formatString: 0.0%
		displayFolder: Money

	/// Wage bill as a share of revenue with owner-funded sponsorship taken out.
	measure 'Wages to Revenue (Without Owner Money)' = DIVIDE ( [Wage Bill], [Revenue] - [Owner-Funded Sponsorship] )
		formatString: 0.0%
		displayFolder: Money

	/// Costs the verdict found kept off City's books.
	measure 'Hidden Costs' = SUM ( 'Club Seasons'[hidden_cost_gbp_m] )
		formatString: £#,0.0"m"
		displayFolder: Money

	/// City's wages to reported revenue across the seasons the charges cover.
	measure 'City Wages to Revenue 2009-18' = CALCULATE ( [Wages to Revenue], REMOVEFILTERS ( 'Club Seasons' ), REMOVEFILTERS ( Seasons ), REMOVEFILTERS ( Clubs ), 'Club Seasons'[club] = "Manchester City", 'Club Seasons'[season] >= "2009-10", 'Club Seasons'[season] <= "2017-18" )
		formatString: 0.0%
		displayFolder: Money

	/// The same without the owner-funded sponsorship.
	measure 'City Wages to Revenue 2009-18 (Without Owner Money)' = CALCULATE ( [Wages to Revenue (Without Owner Money)], REMOVEFILTERS ( 'Club Seasons' ), REMOVEFILTERS ( Seasons ), REMOVEFILTERS ( Clubs ), 'Club Seasons'[club] = "Manchester City", 'Club Seasons'[season] >= "2009-10", 'Club Seasons'[season] <= "2017-18" )
		formatString: 0.0%
		displayFolder: Money

	column club
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: club

	column season
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: season

	column position
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: position

	column pts
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: pts

	column won
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: won

	column drawn
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: drawn

	column lost
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: lost

	column gf
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: gf

	column ga
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: ga

	column gd
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: gd

	column champions
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: champions

	column fy_end
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: fy_end

	column months
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: months

	column wages_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: wages_gbp_m

	column wages_12m_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: wages_12m_gbp_m

	column revenue_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: revenue_gbp_m

	column partial_year
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: partial_year

	column low_confidence
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: low_confidence

	column source_url
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: source_url

	column transfer_spend_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: transfer_spend_gbp_m

	column transfer_income_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: transfer_income_gbp_m

	column net_spend_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: net_spend_gbp_m

	column hidden_cost_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: hidden_cost_gbp_m

	column owner_funded_sponsorship_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: owner_funded_sponsorship_gbp_m

	partition 'Club Seasons' = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "club_seasons.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"champions", each if _ = null then null else Text.Lower(_)}, {"partial_year", each if _ = null then null else Text.Lower(_)}, {"low_confidence", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"club", type text},
				            {"season", type text},
				            {"position", Int64.Type},
				            {"pts", Int64.Type},
				            {"won", Int64.Type},
				            {"drawn", Int64.Type},
				            {"lost", Int64.Type},
				            {"gf", Int64.Type},
				            {"ga", Int64.Type},
				            {"gd", Int64.Type},
				            {"champions", type logical},
				            {"fy_end", type text},
				            {"months", Int64.Type},
				            {"wages_gbp_m", type number},
				            {"wages_12m_gbp_m", type number},
				            {"revenue_gbp_m", type number},
				            {"partial_year", type logical},
				            {"low_confidence", type logical},
				            {"source_url", type text},
				            {"transfer_spend_gbp_m", type number},
				            {"transfer_income_gbp_m", type number},
				            {"net_spend_gbp_m", type number},
				            {"hidden_cost_gbp_m", type number},
				            {"owner_funded_sponsorship_gbp_m", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

