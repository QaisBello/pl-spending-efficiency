/// Every recorded transfer in and out for the six clubs, 2008-09 to 2025-26 (Transfermarkt via ewenme and dcaribou), fees converted to pounds at the daily rate.
table Transfers

	/// Fees paid for incoming players.
	measure 'Transfer Fees Paid' = CALCULATE ( SUM ( Transfers[fee_gbp_m] ), Transfers[direction] = "in" )
		formatString: £#,0.0"m"
		displayFolder: Transfers

	/// Fees received.
	measure 'Transfer Fees Received' = CALCULATE ( SUM ( Transfers[fee_gbp_m] ), Transfers[direction] = "out" )
		formatString: £#,0.0"m"
		displayFolder: Transfers

	/// Players signed (including free and loan).
	measure Signings = CALCULATE ( COUNTROWS ( Transfers ), Transfers[direction] = "in" )
		formatString: #,0
		displayFolder: Transfers

	column club
		dataType: string
		summarizeBy: none
		sourceColumn: club

	column season
		dataType: string
		summarizeBy: none
		sourceColumn: season

	column window
		dataType: string
		summarizeBy: none
		sourceColumn: window

	column direction
		dataType: string
		summarizeBy: none
		sourceColumn: direction

	column player
		dataType: string
		summarizeBy: none
		sourceColumn: player

	column other_club
		dataType: string
		summarizeBy: none
		sourceColumn: other_club

	column fee_text
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: fee_text

	column fee_type
		dataType: string
		summarizeBy: none
		sourceColumn: fee_type

	column fee_eur_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: fee_eur_m

	column source
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: source

	column fee_gbp_m
		dataType: double
		formatString: £#,0.0"m"
		summarizeBy: none
		sourceColumn: fee_gbp_m

	partition Transfers = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "transfers.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"club", type text},
				            {"season", type text},
				            {"window", type text},
				            {"direction", type text},
				            {"player", type text},
				            {"other_club", type text},
				            {"fee_text", type text},
				            {"fee_type", type text},
				            {"fee_eur_m", type number},
				            {"source", type text},
				            {"fee_gbp_m", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

