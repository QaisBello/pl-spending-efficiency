		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: cost_per_point_gbp_m

	column wages_per_point_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: wages_per_point_gbp_m

	column wage_revenue_pct
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
