		summarizeBy: none
		sourceColumn: source_url

	column transfer_spend_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: transfer_spend_gbp_m

	column transfer_income_gbp_m
		dataType: double
