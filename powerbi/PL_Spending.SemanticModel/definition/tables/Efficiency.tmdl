	column wages_adj_gbp_m
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: wages_adj_gbp_m

	column wage_index
		dataType: double
		formatString: 0.00
		summarizeBy: none
