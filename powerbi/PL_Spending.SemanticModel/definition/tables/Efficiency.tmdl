		formatString: #,0.00
		summarizeBy: none
		sourceColumn: wage_revenue_pct_adj

	column 'Club Season'
		dataType: string
		summarizeBy: none
		sourceColumn: Club Season

	partition Efficiency = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "efficiency.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"champions", each if _ = null then null else Text.Lower(_)}, {"partial_year", each if _ = null then null else Text.Lower(_)}, {"low_confidence", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"club", type text},
				            {"season", type text},
				            {"position", Int64.Type},
				            {"pts", Int64.Type},
				            {"won", Int64.Type},
				            {"drawn", Int64.Type},
				            {"lost", Int64.Type},
				            {"gf", Int64.Type},
				            {"ga", Int64.Type},
				            {"gd", Int64.Type},
				            {"champions", type logical},
				            {"fy_end", type text},
				            {"months", Int64.Type},
				            {"wages_gbp_m", type number},
				            {"wages_12m_gbp_m", type number},
				            {"revenue_gbp_m", type number},
				            {"partial_year", type logical},
				            {"low_confidence", type logical},
				            {"source_url", type text},
				            {"transfer_spend_gbp_m", type number},
				            {"transfer_income_gbp_m", type number},
				            {"net_spend_gbp_m", type number},
				            {"hidden_cost_gbp_m", type number},
				            {"owner_funded_sponsorship_gbp_m", type number},
				            {"wages_adj_gbp_m", type number},
				            {"wage_index", type number},
				            {"expected_pts", type number},
				            {"over_pts", type number},
				            {"wage_index_adj", type number},
				            {"expected_pts_adj", type number},
				            {"over_pts_adj", type number},
				            {"squad_cost_gbp_m", type number},
				            {"cost_per_point_gbp_m", type number},
				            {"wages_per_point_gbp_m", type number},
				            {"wage_revenue_pct", type number},
				            {"wage_revenue_pct_adj", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    #"Club Season" = Table.AddColumn(#"Filtered Rows", "Club Season", each [club] & " " & [season], type text),
				    Result = #"Club Season"
				in
				    Result
				```

