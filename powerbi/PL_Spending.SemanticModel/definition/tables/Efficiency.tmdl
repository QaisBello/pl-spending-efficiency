/// One row per club per season where all six wage bills are known (15 seasons x 6 clubs = 90). Expected points come from the Python regression of points on the wage index (wage bill / top-six average that season).
table Efficiency

	/// League points.
	measure Points = SUM ( Efficiency[pts] )
		formatString: #,0
		displayFolder: Results

	/// League titles.
	measure Titles = CALCULATE ( COUNTROWS ( Efficiency ), Efficiency[champions] == TRUE () )
		formatString: #,0
		displayFolder: Results

	/// Points per season.
	measure 'Average Points' = AVERAGE ( Efficiency[pts] )
		formatString: 0.0
		displayFolder: Results

	/// Points the wage index predicts (Python regression).
	measure 'Expected Points' = SUM ( Efficiency[expected_pts] )
		formatString: #,0
		displayFolder: Model

	/// Actual minus expected points.
	measure 'Points Above Expected' = SUM ( Efficiency[over_pts] )
		formatString: +#,0.0;-#,0.0;0
		displayFolder: Model

	/// Average points a season above (or below) what the wage bill predicts.
	measure 'Points Above Expected per Season' = AVERAGE ( Efficiency[over_pts] )
		formatString: +0.0;-0.0;0.0
		displayFolder: Model

	/// The same, with the costs the 114-charge verdict found hidden added to City's wage bill.
	measure 'Points Above Expected per Season (Adjusted)' = AVERAGE ( Efficiency[over_pts_adj] )
		formatString: +0.0;-0.0;0.0
		displayFolder: Model

	/// Wage bill against the top-six average that season (1.00 = average).
	measure 'Average Wage Index' = AVERAGE ( Efficiency[wage_index] )
		formatString: 0.00
		displayFolder: Model

	/// Fees paid minus fees received.
	measure 'Net Transfer Spend' = SUM ( Efficiency[net_spend_gbp_m] )
		formatString: £#,0.0"m"
		displayFolder: Money

	/// Wages (12-month basis) plus net transfer spend.
	measure 'Squad Cost' = SUM ( Efficiency[squad_cost_gbp_m] )
		formatString: £#,0.0"m"
		displayFolder: Money

	/// Squad cost per league point.
	measure 'Cost per Point' = DIVIDE ( [Squad Cost], [Points] )
		formatString: £#,0.00"m"
		displayFolder: Money

	column club
		dataType: string
		summarizeBy: none
		sourceColumn: club

	column season
		dataType: string
		summarizeBy: none
		sourceColumn: season

	column position
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: position

	column pts
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: pts

	column won
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: won

	column drawn
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: drawn

	column lost
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: lost

	column gf
		dataType: int64
		isHidden
