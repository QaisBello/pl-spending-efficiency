		formatString: #,0.00
		summarizeBy: none
		sourceColumn: expected_pts

	column over_pts
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: over_pts

	column wage_index_adj
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: wage_index_adj

	column expected_pts_adj
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: expected_pts_adj

	column over_pts_adj
		dataType: double
