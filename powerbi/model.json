  "measures": [
    {
      "name": "Points",
      "table": "Efficiency",
      "folder": "Results",
      "format": "#,0",
      "dax": "SUM ( Efficiency[pts] )",
      "description": "League points."
    },
    {
      "name": "Titles",
      "table": "Efficiency",
      "folder": "Results",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Efficiency ), Efficiency[champions] == TRUE () )",
      "description": "League titles."
    },
    {
      "name": "Average Points",
      "table": "Efficiency",
      "folder": "Results",
      "format": "0.0",
      "dax": "AVERAGE ( Efficiency[pts] )",
      "description": "Points per season."
    },
    {
      "name": "Expected Points",
      "table": "Efficiency",
      "folder": "Model",
      "format": "#,0",
      "dax": "SUM ( Efficiency[expected_pts] )",
      "description": "Points the wage index predicts (Python regression)."
    },
    {
      "name": "Points Above Expected",
      "table": "Efficiency",
      "folder": "Model",
      "format": "+#,0.0;-#,0.0;0",
      "dax": "SUM ( Efficiency[over_pts] )",
      "description": "Actual minus expected points."
    },
    {
      "name": "Points Above Expected per Season",
      "table": "Efficiency",
      "folder": "Model",
      "format": "+0.0;-0.0;0.0",
      "dax": "AVERAGE ( Efficiency[over_pts] )",
      "description": "Average points a season above (or below) what the wage bill predicts."
    },
    {
      "name": "Points Above Expected per Season (Adjusted)",
      "table": "Efficiency",
      "folder": "Model",
      "format": "+0.0;-0.0;0.0",
      "dax": "AVERAGE ( Efficiency[over_pts_adj] )",
      "description": "The same, with the costs the 114-charge verdict found hidden added to City's wage bill."
    },
    {
      "name": "Average Wage Index",
      "table": "Efficiency",
      "folder": "Model",
      "format": "0.00",
      "dax": "AVERAGE ( Efficiency[wage_index] )",
      "description": "Wage bill against the top-six average that season (1.00 = average)."
    },
    {
      "name": "Wage Bill",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "SUM ( 'Club Seasons'[wages_gbp_m] )",
      "description": "Wages as reported in the accounts."
    },
    {
      "name": "Revenue",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "SUM ( 'Club Seasons'[revenue_gbp_m] )",
      "description": "Revenue as reported."
    },
    {
      "name": "Owner-Funded Sponsorship",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "SUM ( 'Club Seasons'[owner_funded_sponsorship_gbp_m] )",
      "description": "Sponsorship the verdict found was funded by the owner (City only)."
    },
    {
      "name": "Wages to Revenue",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "0.0%",
      "dax": "DIVIDE ( [Wage Bill], [Revenue] )",
      "description": "Wage bill as a share of reported revenue."
    },
    {
      "name": "Wages to Revenue (Without Owner Money)",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "0.0%",
      "dax": "DIVIDE ( [Wage Bill], [Revenue] - [Owner-Funded Sponsorship] )",
      "description": "Wage bill as a share of revenue with owner-funded sponsorship taken out."
    },
    {
      "name": "Net Transfer Spend",
      "table": "Efficiency",
      "folder": "Money",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "SUM ( Efficiency[net_spend_gbp_m] )",
      "description": "Fees paid minus fees received."
    },
    {
      "name": "Squad Cost",
      "table": "Efficiency",
      "folder": "Money",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "SUM ( Efficiency[squad_cost_gbp_m] )",
      "description": "Wages (12-month basis) plus net transfer spend."
    },
    {
      "name": "Cost per Point",
      "table": "Efficiency",
      "folder": "Money",
      "format": "\u00a3#,0.00\"m\"",
      "dax": "DIVIDE ( [Squad Cost], [Points] )",
      "description": "Squad cost per league point."
    },
    {
      "name": "Hidden Costs",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "SUM ( 'Club Seasons'[hidden_cost_gbp_m] )",
      "description": "Costs the verdict found kept off City's books."
    },
    {
      "name": "City Wages to Revenue 2009-18",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "0.0%",
      "dax": "CALCULATE ( [Wages to Revenue], REMOVEFILTERS ( 'Club Seasons' ), REMOVEFILTERS ( Seasons ), REMOVEFILTERS ( Clubs ), 'Club Seasons'[club] = \"Manchester City\", 'Club Seasons'[season] >= \"2009-10\", 'Club Seasons'[season] <= \"2017-18\" )",
      "description": "City's wages to reported revenue across the seasons the charges cover."
    },
    {
      "name": "City Wages to Revenue 2009-18 (Without Owner Money)",
      "table": "Club Seasons",
      "folder": "Money",
      "format": "0.0%",
      "dax": "CALCULATE ( [Wages to Revenue (Without Owner Money)], REMOVEFILTERS ( 'Club Seasons' ), REMOVEFILTERS ( Seasons ), REMOVEFILTERS ( Clubs ), 'Club Seasons'[club] = \"Manchester City\", 'Club Seasons'[season] >= \"2009-10\", 'Club Seasons'[season] <= \"2017-18\" )",
      "description": "The same without the owner-funded sponsorship."
    },
    {
      "name": "Transfer Fees Paid",
      "table": "Transfers",
      "folder": "Transfers",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "CALCULATE ( SUM ( Transfers[fee_gbp_m] ), Transfers[direction] = \"in\" )",
      "description": "Fees paid for incoming players."
    },
    {
      "name": "Transfer Fees Received",
      "table": "Transfers",
      "folder": "Transfers",
      "format": "\u00a3#,0.0\"m\"",
      "dax": "CALCULATE ( SUM ( Transfers[fee_gbp_m] ), Transfers[direction] = \"out\" )",
      "description": "Fees received."
    },
    {
      "name": "Signings",
      "table": "Transfers",
      "folder": "Transfers",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Transfers ), Transfers[direction] = \"in\" )",
      "description": "Players signed (including free and loan)."
    }
  ],
